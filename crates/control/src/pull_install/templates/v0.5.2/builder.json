[
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "${installation}-builder-server-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "type": "Opaque",
    "data": "${builderServerCredentials}"
  },
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {
      "name": "${installation}-builder-client-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "type": "Opaque",
    "data": "${builderClientCredentials}"
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "${installation}-builder-config-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "data": {
      "buildkitd.toml": "${workerConfiguration}"
    },
    "immutable": true
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "${installation}-builder-template-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "data": {
      "pod.json": "${builderPodJson}"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "${installation}-builders-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}",
        "kimage.dev/role": "builder-catalog",
        "kimage.dev/worker-architecture": "${architecture}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "data": {
      "catalog.json": "${builderCatalog}"
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "${installation}-builder-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "spec": {
      "selector": {
        "kimage.dev/installation": "${installation}",
        "kimage.dev/role": "builder",
        "kimage.dev/worker-architecture": "${architecture}"
      },
      "ports": [
        {
          "port": 1234,
          "targetPort": 1234
        }
      ]
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "${installation}-builder-isolation-${architecture}",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "namespace": "${namespace}",
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "spec": {
      "podSelector": {
        "matchLabels": {
          "kimage.dev/installation": "${installation}",
          "kimage.dev/role": "builder",
          "kimage.dev/worker-architecture": "${architecture}"
        }
      },
      "policyTypes": [
        "Ingress",
        "Egress"
      ],
      "egress": [],
      "ingress": [
        {
          "from": [
            {
              "podSelector": {
                "matchLabels": {
                  "kimage.dev/installation": "${installation}",
                  "kimage.dev/role": "builder-client"
                }
              }
            },
            {
              "namespaceSelector": "${scopeSelector}",
              "podSelector": {
                "matchLabels": {
                  "kimage.dev/build-installation": "${installation}",
                  "kimage.dev/role": "builder-client"
                }
              }
            }
          ],
          "ports": [
            {
              "protocol": "TCP",
              "port": 1234
            }
          ]
        }
      ]
    }
  }
]
