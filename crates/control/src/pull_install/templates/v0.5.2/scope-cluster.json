[
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "${installation}-application-operator",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "rules": [
      {
        "apiGroups": [
          "kimage.dev"
        ],
        "resources": [
          "images"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "patch"
        ]
      },
      {
        "apiGroups": [
          "kimage.dev"
        ],
        "resources": [
          "images/status",
          "imagereleases/status"
        ],
        "verbs": [
          "get",
          "patch"
        ]
      },
      {
        "apiGroups": [
          "kimage.dev"
        ],
        "resources": [
          "imagereleases"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "patch",
          "delete"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "persistentvolumeclaims"
        ],
        "verbs": [
          "get"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "delete"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "pods/exec"
        ],
        "verbs": [
          "get",
          "create"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "configmaps"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "delete"
        ]
      },
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "secrets"
        ],
        "verbs": [
          "get",
          "list",
          "watch",
          "create",
          "patch",
          "delete"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "${installation}-application-operator",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "${installation}-operator",
        "namespace": "${namespace}"
      }
    ],
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "${installation}-application-operator"
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "${installation}-application-admission",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "rules": [
      {
        "apiGroups": [
          "kimage.dev"
        ],
        "resources": [
          "images",
          "imagereleases"
        ],
        "verbs": [
          "get",
          "list"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "${installation}-application-admission",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/manager": "${manager}"
      }
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "${installation}-admission",
        "namespace": "${namespace}"
      }
    ],
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "${installation}-application-admission"
    }
  }
]
