{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "${installation}-builder-${architecture}",
    "labels": {
      "kimage.dev/installation": "${installation}",
      "kimage.dev/role": "builder",
      "kimage.dev/worker-architecture": "${architecture}"
    },
    "namespace": "${namespace}",
    "annotations": {
      "kimage.dev/manager": "${manager}"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "restartPolicy": "Always",
    "hostNetwork": false,
    "dnsPolicy": "ClusterFirst",
    "securityContext": {
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "builder",
        "image": "${builderImage}",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "/kimage-builder"
        ],
        "args": [
          "--config",
          "/configuration/buildkitd.toml"
        ],
        "env": [
          {
            "name": "PATH",
            "value": "/"
          },
          {
            "name": "OTEL_TRACES_EXPORTER",
            "value": "none"
          }
        ],
        "volumeMounts": [
          {
            "name": "cache",
            "mountPath": "/cache",
            "readOnly": false
          },
          {
            "name": "run",
            "mountPath": "/run",
            "readOnly": false
          },
          {
            "name": "tmp",
            "mountPath": "/tmp",
            "readOnly": false
          },
          {
            "name": "config",
            "mountPath": "/configuration",
            "readOnly": true
          },
          {
            "name": "credentials",
            "mountPath": "/credentials",
            "readOnly": true
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "1Gi",
            "ephemeral-storage": "5Gi"
          }
        },
        "securityContext": {
          "runAsUser": 0,
          "runAsGroup": 0,
          "privileged": false,
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "procMount": "Unmasked",
          "seccompProfile": {
            "type": "Unconfined"
          },
          "appArmorProfile": {
            "type": "Unconfined"
          },
          "capabilities": {
            "drop": [
              "ALL"
            ],
            "add": "${workerCapabilities}"
          }
        },
        "readinessProbe": {
          "exec": {
            "command": [
              "/buildctl",
              "--addr",
              "unix:///run/buildkit/buildkitd.sock",
              "debug",
              "workers"
            ]
          },
          "periodSeconds": 5,
          "timeoutSeconds": 5
        }
      }
    ],
    "volumes": [
      {
        "name": "cache",
        "emptyDir": {
          "sizeLimit": "4Gi"
        }
      },
      {
        "name": "run",
        "emptyDir": {
          "sizeLimit": "16Mi"
        }
      },
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "256Mi"
        }
      },
      {
        "name": "config",
        "configMap": {
          "name": "${installation}-builder-config-${architecture}"
        }
      },
      {
        "name": "credentials",
        "secret": {
          "secretName": "${installation}-builder-server-${architecture}",
          "defaultMode": 256
        }
      }
    ],
    "affinity": {
      "nodeAffinity": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "nodeSelectorTerms": [
            {
              "matchFields": [
                {
                  "key": "metadata.name",
                  "operator": "In",
                  "values": [
                    "${node}"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "hostUsers": false
  }
}
