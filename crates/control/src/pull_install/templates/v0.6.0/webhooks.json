[
  {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "MutatingWebhookConfiguration",
    "metadata": {
      "name": "${installation}-resolution",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/scope": "${scopeJson}",
        "kimage.dev/manager": "${manager}"
      }
    },
    "webhooks": [
      {
        "name": "${installation}.kimage.dev",
        "admissionReviewVersions": [
          "v1"
        ],
        "sideEffects": "NoneOnDryRun",
        "failurePolicy": "Fail",
        "matchPolicy": "Equivalent",
        "timeoutSeconds": 5,
        "namespaceSelector": "${scopeSelector}",
        "clientConfig": {
          "service": {
            "name": "${installation}-admission",
            "namespace": "${namespace}",
            "path": "/mutate",
            "port": 443
          },
          "caBundle": "${admissionCa}"
        },
        "rules": [
          {
            "apiGroups": [
              ""
            ],
            "apiVersions": [
              "v1"
            ],
            "operations": [
              "CREATE",
              "UPDATE"
            ],
            "resources": [
              "pods",
              "pods/ephemeralcontainers"
            ],
            "scope": "Namespaced"
          }
        ],
        "reinvocationPolicy": "IfNeeded"
      }
    ]
  },
  {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "ValidatingWebhookConfiguration",
    "metadata": {
      "name": "${installation}-retention",
      "labels": {
        "kimage.dev/installation": "${installation}"
      },
      "annotations": {
        "kimage.dev/scope": "${scopeJson}",
        "kimage.dev/manager": "${manager}"
      }
    },
    "webhooks": [
      {
        "name": "${installation}.retention.kimage.dev",
        "admissionReviewVersions": [
          "v1"
        ],
        "sideEffects": "None",
        "failurePolicy": "Fail",
        "matchPolicy": "Equivalent",
        "timeoutSeconds": 5,
        "namespaceSelector": "${scopeSelector}",
        "clientConfig": {
          "service": {
            "name": "${installation}-admission",
            "namespace": "${namespace}",
            "path": "/retain",
            "port": 443
          },
          "caBundle": "${admissionCa}"
        },
        "rules": [
          {
            "apiGroups": [
              "kimage.dev"
            ],
            "apiVersions": [
              "v1alpha1"
            ],
            "operations": [
              "CREATE",
              "DELETE",
              "UPDATE"
            ],
            "resources": [
              "imagereleases"
            ],
            "scope": "Namespaced"
          }
        ]
      }
    ]
  }
]
